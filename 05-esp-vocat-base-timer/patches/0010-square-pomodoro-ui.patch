+#include "share/DigitalTimerUi.h"
+#include <algorithm>
+#include <cmath>
+
+void drawDigitalTimerUiCore(M5Canvas *spi, m5avatar::BoundingRect rect,
+                             uint32_t seconds, uint32_t totalSeconds)
+{
+  const int32_t left = rect.getLeft();
+  const int32_t top = rect.getTop();
+  const int32_t width = rect.getWidth();
+  const int32_t height = rect.getHeight();
+  const uint8_t digits[] = {
+    static_cast<uint8_t>((seconds / 60) / 10), static_cast<uint8_t>((seconds / 60) % 10),
+    static_cast<uint8_t>((seconds % 60) / 10), static_cast<uint8_t>(seconds % 10)
+  };
+  const char *segments[] = {"abcdef", "bc", "abdeg", "abcdg", "bcfg",
+                            "acdfg", "acdefg", "abc", "abcdefg", "abcdfg"};
+  const int32_t digitW = 34;
+  const int32_t gap = 4;
+  const int32_t colonW = 24;
+  const int32_t displayW = digitW * 4 + gap * 2 + colonW;
+  const int32_t displayLeft = left + (width - displayW) / 2;
+  const int32_t displayTop = top + (height - 68) / 2;
+  const uint16_t white = TFT_WHITE;
+  const uint16_t dim = 0x2125;
+
+  spi->fillRect(left, top, width, height, TFT_BLACK);
+  for (int digitIndex = 0; digitIndex < 4; ++digitIndex) {
+    const int32_t x = displayLeft + digitIndex * digitW
+                    + (digitIndex % 2 == 1 ? gap : 0)
+                    + (digitIndex >= 2 ? colonW + gap : 0);
+    const int32_t y = displayTop;
+    const char *active = segments[digits[digitIndex]];
+    const int32_t sx = x;
+    const int32_t sy = y;
+    const int32_t segW = 24;
+    const int32_t segH = 7;
+    const int32_t sideW = 7;
+    const int32_t sideH = 27;
+    const int32_t segX = sx + 5;
+    auto drawSegment = [&](char name, int32_t px, int32_t py, int32_t sw, int32_t sh) {
+      spi->fillRoundRect(px, py, sw, sh, 2,
+                         strchr(active, name) != NULL ? white : dim);
+    };
+    drawSegment('a', segX, sy, segW, segH);
+    drawSegment('g', segX, sy + 30, segW, segH);
+    drawSegment('d', segX, sy + 61, segW, segH);
+    drawSegment('f', sx, sy + 5, sideW, sideH);
+    drawSegment('b', sx + 27, sy + 5, sideW, sideH);
+    drawSegment('e', sx, sy + 36, sideW, sideH);
+    drawSegment('c', sx + 27, sy + 36, sideW, sideH);
+  }
+
+  const int32_t colonX = displayLeft + digitW * 2 + gap;
+  spi->fillCircle(colonX + colonW / 2, displayTop + 25, 3, white);
+  spi->fillCircle(colonX + colonW / 2, displayTop + 47, 3, white);
+
+  const int32_t stroke = 8;
+  const int32_t inset = stroke / 2;
+  const int32_t pathLeft = left + inset;
+  const int32_t pathTop = top + inset;
+  const int32_t pathRight = left + width - inset;
+  const int32_t pathBottom = top + height - inset;
+  const float horizontal = static_cast<float>(pathRight - pathLeft);
+  const float vertical = static_cast<float>(pathBottom - pathTop);
+  const float topHalf = horizontal / 2.0f;
+  const float perimeter = horizontal * 2.0f + vertical * 2.0f;
+  const float fraction = totalSeconds == 0
+      ? 0.0f
+      : std::min(1.0f, std::max(0.0f,
+          1.0f - static_cast<float>(seconds) / totalSeconds));
+
+  auto drawTop = [&](int32_t x, int32_t length, uint16_t color) {
+    if (length > 0) spi->fillRect(x - 1, pathTop - stroke / 2,
+                                  length + 2, stroke, color);
+  };
+  auto drawBottom = [&](int32_t x, int32_t length, uint16_t color) {
+    if (length > 0) spi->fillRect(x - 1, pathBottom - stroke / 2,
+                                  length + 2, stroke, color);
+  };
+  auto drawRight = [&](int32_t y, int32_t length, uint16_t color) {
+    if (length > 0) spi->fillRect(pathRight - stroke / 2, y - 1,
+                                  stroke, length + 2, color);
+  };
+  auto drawLeft = [&](int32_t y, int32_t length, uint16_t color) {
+    if (length > 0) spi->fillRect(pathLeft - stroke / 2, y - 1,
+                                  stroke, length + 2, color);
+  };
+
+  const uint16_t track = 0x3186;
+  drawTop(pathLeft, static_cast<int32_t>(horizontal), track);
+  drawRight(pathTop, static_cast<int32_t>(vertical), track);
+  drawBottom(pathLeft, static_cast<int32_t>(horizontal), track);
+  drawLeft(pathTop, static_cast<int32_t>(vertical), track);
+
+  float remaining = perimeter * fraction;
+  const int32_t topRightLength = static_cast<int32_t>(topHalf);
+  if (remaining > 0) {
+    const int32_t length = std::min(topRightLength, static_cast<int32_t>(remaining));
+    drawTop(pathLeft + topRightLength, length, white);
+    remaining -= topRightLength;
+  }
+  if (remaining > 0) {
+    const int32_t length = std::min(static_cast<int32_t>(vertical), static_cast<int32_t>(remaining));
+    drawRight(pathTop, length, white);
+    remaining -= vertical;
+  }
+  if (remaining > 0) {
+    const int32_t length = std::min(static_cast<int32_t>(horizontal), static_cast<int32_t>(remaining));
+    drawBottom(pathRight - length, length, white);
+    remaining -= horizontal;
+  }
+  if (remaining > 0) {
+    const int32_t length = std::min(static_cast<int32_t>(vertical), static_cast<int32_t>(remaining));
+    drawLeft(pathBottom - length, length, white);
+    remaining -= vertical;
+  }
+  if (remaining > 0) {
+    const int32_t length = std::min(static_cast<int32_t>(topHalf), static_cast<int32_t>(remaining));
+    drawTop(pathLeft, length, white);
+  }
+}

