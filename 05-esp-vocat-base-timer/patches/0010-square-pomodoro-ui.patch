+void PomodoroMod::drawTimerUi(M5Canvas *spi, m5avatar::BoundingRect rect,
+                              m5avatar::DrawContext * /*ctx*/, void *userData)
+{
+  PomodoroMod *pomodoro = static_cast<PomodoroMod *>(userData);
+  const int32_t left = rect.getLeft();
+  const int32_t top = rect.getTop();
+  const int32_t width = rect.getWidth();
+  const int32_t height = rect.getHeight();
+  const int32_t side = (width < height ? width : height) - 16;
+  const int32_t squareLeft = left + (width - side) / 2;
+  const int32_t squareTop = top + (height - side) / 2;
+  const int32_t radius = 22;
+  const float pi = 3.14159265359f;
+  const float straight = static_cast<float>(side - 2 * radius);
+  const float arc = pi * radius / 2.0f;
+  const float perimeter = 4.0f * straight + 4.0f * arc;
+
+  struct Point { float x; float y; };
+  auto pointAt = [&](float distance) -> Point {
+    while (distance < 0) distance += perimeter;
+    while (distance >= perimeter) distance -= perimeter;
+    const float x = squareLeft;
+    const float y = squareTop;
+    const float right = squareLeft + side;
+    const float bottom = squareTop + side;
+    const float r = radius;
+    const float topEnd = right - r;
+    const float bottomEnd = right - r;
+    const float segments[] = { straight / 2.0f, arc, straight, arc, straight, arc, straight, arc, straight / 2.0f };
+    float d = distance;
+    for (int i = 0; i < 9; ++i) {
+      if (d <= segments[i]) {
+        const float t = segments[i] > 0 ? d / segments[i] : 0;
+        switch (i) {
+          case 0: return { squareLeft + side / 2.0f + (topEnd - (squareLeft + side / 2.0f)) * t, y };
+          case 1: {
+            const float a = -pi / 2.0f + (pi / 2.0f) * t;
+            return { topEnd + r * cosf(a), y + r + r * sinf(a) };
+          }
+          case 2: return { right, y + r + straight * t };
+          case 3: {
+            const float a = (pi / 2.0f) * t;
+            return { right - r + r * cosf(a), bottom - r + r * sinf(a) };
+          }
+          case 4: return { bottomEnd - straight * t, bottom };
+          case 5: {
+            const float a = pi / 2.0f + (pi / 2.0f) * t;
+            return { squareLeft + r + r * cosf(a), bottom - r + r * sinf(a) };
+          }
+          case 6: return { x, bottom - r - straight * t };
+          case 7: {
+            const float a = pi + (pi / 2.0f) * t;
+            return { squareLeft + r + r * cosf(a), y + r + r * sinf(a) };
+          }
+          default: return { topEnd - (topEnd - (squareLeft + side / 2.0f)) * t, y };
+        }
+      }
+      d -= segments[i];
+    }
+    return { squareLeft + side / 2.0f, static_cast<float>(squareTop) };
+  };
+
+  spi->fillRect(left, top, width, height, TFT_BLACK);
+  spi->drawRoundRect(squareLeft, squareTop, side, side, radius, 0x39C7);
+
+  uint32_t seconds = 0;
+  float fraction = 0.0f;
+  if (pomodoro->xTimer != NULL && xTimerIsTimerActive(pomodoro->xTimer) != pdFALSE) {
+    TickType_t remaining = xTimerGetExpiryTime(pomodoro->xTimer) - xTaskGetTickCount();
+    seconds = (remaining + configTICK_RATE_HZ - 1) / configTICK_RATE_HZ;
+    const uint32_t duration = pomodoro->status == TIMER5 ? 5 * 60 : 25 * 60;
+    fraction = 1.0f - static_cast<float>(seconds) / duration;
+    if (fraction < 0.0f) fraction = 0.0f;
+    if (fraction > 1.0f) fraction = 1.0f;
+  }
+
+  for (int i = 0; i < 100; ++i) {
+    const float f = static_cast<float>(i) / 100.0f;
+    const Point p = pointAt(f * perimeter);
+    const Point before = pointAt(f * perimeter - 1.0f);
+    const Point after = pointAt(f * perimeter + 1.0f);
+    const float tx = after.x - before.x;
+    const float ty = after.y - before.y;
+    const float tangentLength = sqrtf(tx * tx + ty * ty);
+    const float length = tangentLength > 0.0f ? tangentLength : 1.0f;
+    const float nx = -ty / length;
+    const float ny = tx / length;
+    const float mark = i % 20 == 0 ? 8.0f : i % 4 == 0 ? 5.0f : i % 2 == 0 ? 3.5f : 2.5f;
+    const uint16_t color = i % 20 == 0 ? TFT_WHITE : 0x7BEF;
+    spi->drawLine(p.x - nx * mark / 2, p.y - ny * mark / 2,
+                  p.x + nx * mark / 2, p.y + ny * mark / 2, color);
+  }
+
+  const Point start = pointAt(0);
+  spi->fillCircle(start.x, start.y, 7, TFT_WHITE);
+  Point previous = start;
+  for (int i = 1; i <= 100; ++i) {
+    const Point current = pointAt(fraction * perimeter * i / 100.0f);
+    spi->drawLine(previous.x, previous.y, current.x, current.y, TFT_WHITE);
+    previous = current;
+  }
+
+  const Point handle = pointAt(fraction * perimeter);
+  if (fraction > 0.0f) {
+    spi->fillCircle(handle.x, handle.y, 7, TFT_WHITE);
+    spi->drawCircle(handle.x, handle.y, 7, TFT_WHITE);
+  }
+
+  char timeText[8];
+  snprintf(timeText, sizeof(timeText), "%02lu:%02lu", seconds / 60, seconds % 60);
+  spi->setFont(&fonts::Font4);
+  spi->setTextDatum(middle_center);
+  spi->setTextColor(TFT_WHITE, TFT_BLACK);
+  spi->drawString(timeText, left + width / 2, top + height / 2);
 }
 
 
