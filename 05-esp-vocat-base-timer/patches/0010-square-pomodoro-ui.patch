+void PomodoroMod::adjustDuration(int32_t minutes)
+{
+  if (status != READY || isPaused) return;
+  int32_t duration = static_cast<int32_t>(selectedDurationMs / 60000) + minutes;
+  if (duration < 0) duration = 0;
+  if (duration > 60) duration = 60;
+  selectedDurationMs = static_cast<uint32_t>(duration) * 60000;
+  updateTimerUi();
+}
