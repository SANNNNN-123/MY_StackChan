## App config for the normal text ChatGPT flow (SPIFFS flat layout)
llm:
  type: 0               # ChatGPT text API; use env m5stack-cores3-local-bridge
  model: "gpt-4o-mini"  # Faster text model experiment; supports function calling
  enableMemory: true
  # Leave empty for voice-only. For MCP SSE servers later:
  # mcpServers:
  #   [
  #     {
  #       "name": "local-mcp",
  #       "disabled": false,
  #       "url": "192.168.1.10",
  #       "port": 8000
  #     }
  #   ]
  mcpServers: []

tts:
  type: 5               # Local Mac bridge TTS (LocalBridgeTTS)
  model: "http://192.168.1.10:8787/v1/voice"  # Mac LAN IP, not localhost
  voice: "sarah"

stt:
  type: 4               # Local Mac bridge RevoSpeech ASR
  model: "http://192.168.1.10:8787/v1/transcribe"  # Mac LAN IP, not localhost

wakeword:
  type: 0
  keyword: ""

audio:
  speaker_volume: 200
