+const Point *contourForExpression(Expression expression, bool isLeft,
+                                   size_t *pointCount) {
+  switch (expression) {
+    case Expression::Happy:
+      *pointCount = sizeof(kHappyEye) / sizeof(kHappyEye[0]);
+      return kHappyEye;
+    case Expression::Angry:
+      *pointCount = sizeof(kAngryEye) / sizeof(kAngryEye[0]);
+      return kAngryEye;
+    case Expression::Sad:
+      *pointCount = sizeof(kSadEye) / sizeof(kSadEye[0]);
+      return isLeft ? kSadEye : kDoubtEye;
+    case Expression::Doubt:
+      *pointCount = sizeof(kDoubtEye) / sizeof(kDoubtEye[0]);
+      return isLeft ? kDoubtEye : kSadEye;
+    case Expression::Sleepy:
+      *pointCount = sizeof(kSleepyEye) / sizeof(kSleepyEye[0]);
+      return kSleepyEye;
+    case Expression::Neutral:
+    default:
+      *pointCount = kNeutralEyePointCount;
+      return kNeutralEye;
+  }
+}
