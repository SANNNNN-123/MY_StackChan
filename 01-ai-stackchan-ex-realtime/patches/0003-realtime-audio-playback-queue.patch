+    AudioChunk chunk = {buf, (size_t)len};
+    if(xQueueSend(audioReadyQueue, &chunk, 0) != pdTRUE){
+        xQueueSend(audioFreeQueue, &buf, 0);
+        audioChunksDropped++;
+        return;
