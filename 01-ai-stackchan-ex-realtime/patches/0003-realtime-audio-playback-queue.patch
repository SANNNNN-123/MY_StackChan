+    int len = base64_decode(delta.c_str(), delta.length(), (char*)buf);
+    if(len <= 0 || len > RT_AUDIO_CHUNK_SIZE){
+        xQueueSend(audioFreeQueue, &buf, 0);
+        audioChunksDropped++;
+        return;
+    }
